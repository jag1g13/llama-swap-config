# Copy to .env and fill in real values (.env is gitignored).
# ARC_AI_API_KEY: used by the arc-ai peer in models/llama-swap.yaml
ARC_AI_API_KEY=sk-your-arc-ai-key-here
# ARC_AI_BASE_URL: OpenAI-compatible upstream for the arc-ai peer
ARC_AI_BASE_URL=https://your-gateway.example.com/api
# WEB_UI_SECRET_KEY: signs llama-swap's web UI session cookie
WEB_UI_SECRET_KEY=change-me-to-a-long-random-string
